---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { getCitationCount } from '../utils/citations';

const achievements = (await getCollection('achievements')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Fetch citation counts for publications with an arxivId
const achievementsWithCitations = await Promise.all(
  achievements.map(async (achievement) => {
    let citations = null;
    if (achievement.data.arxivId) {
      citations = await getCitationCount(achievement.data.arxivId);
    }
    return { ...achievement, citations };
  })
);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
  });
};
---

<Layout title="Achievements | Manuel Klettner">
  <h1>Achievements</h1>
  <p>Academic degrees and certifications</p>

  <div class="timeline">
    {
      achievementsWithCitations.map((achievement) => (
        <ExperienceItem
          title={achievement.data.title}
          company={achievement.data.organization || ''}
          period={formatDate(achievement.data.date)}
          description={achievement.body}
          badge={achievement.data.type}
          badgeType={achievement.data.type}
          link={achievement.data.link}
          citations={achievement.citations}
          layout="side"
        />
      ))
    }
  </div>
</Layout>

<style>
  .timeline {
    margin-top: 3rem;
  }
</style>
