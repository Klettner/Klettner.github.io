---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import citationsData from '../data/citations.json';

const achievements = (await getCollection('achievements')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const citations = citationsData as Record<
  string,
  { count: number; lastUpdated: string }
>;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
  });
};
---

<Layout title="Achievements | Manuel Klettner">
  <h1 class="animate-in">Achievements</h1>
  <p class="animate-in">Academic degrees and certifications</p>

  <div class="timeline stagger-children">
    {
      achievements.map((achievement) => (
        <ExperienceItem
          title={achievement.data.title}
          company={achievement.data.organization || ''}
          period={formatDate(achievement.data.date)}
          description={achievement.body}
          badge={achievement.data.type}
          badgeType={achievement.data.type}
          link={achievement.data.link}
          citations={
            achievement.data.arxivId
              ? citations[achievement.data.arxivId]?.count
              : null
          }
          layout="side"
          class="animate-on-scroll"
        />
      ))
    }
  </div>
</Layout>

<style>
  .timeline {
    margin-top: 3rem;
  }
</style>
