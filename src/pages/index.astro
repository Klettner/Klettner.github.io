---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Badge from '../components/Badge.astro';
import profileImage from '../assets/images/profile.jpg';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const achievements = (await getCollection('achievements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Manuel Klettner | Software Engineer">
  <section class="hero animate-in">
    <div class="hero-content">
      <Image
        src={profileImage}
        alt="Manuel Klettner"
        class="profile-pic"
        loading="eager"
      />
      <div>
        <h1>Hi, I'm Manuel Klettner</h1>
        <p class="subtitle">
          Software Engineer | M.Sc. Information Systems (TUM)
        </p>
        <p>
          I am a Software Engineer with a passion for building innovative
          digital solutions. Having completed my M.Sc. in Information Systems at
          the Technical University of Munich, I now work at <strong
            >Rohde & Schwarz</strong
          >, specializing in Cloud Applications and DevOps.
        </p>
      </div>
    </div>
  </section>

  <section class="section animate-on-scroll">
    <h2>Personal Projects</h2>
    <div class="grid stagger-children">
      {
        projects.map((project) => (
          <ProjectCard project={project} variant="summary" />
        ))
      }
    </div>
    <a href="/projects/" class="view-all">View all projects &rarr;</a>
  </section>

  <section class="section animate-on-scroll">
    <h2>Recent Achievements</h2>
    <ul class="achievement-list stagger-children">
      {
        achievements.map((achievement) => (
          <li class="animate-on-scroll">
            <span class="date">
              {achievement.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
              })}
            </span>
            <div class="achievement-content">
              <strong>{achievement.data.title}</strong>
              {achievement.data.organization && (
                <span> at {achievement.data.organization}</span>
              )}
              <Badge type={achievement.data.type}>
                {achievement.data.type}
              </Badge>
            </div>
          </li>
        ))
      }
    </ul>
    <a href="/achievements/" class="view-all">View all achievements &rarr;</a>
  </section>
</Layout>

<style>
  .hero {
    margin-bottom: 4rem;
  }

  .hero-content {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-direction: column;
    text-align: center;
  }

  @media (min-width: 640px) {
    .hero-content {
      flex-direction: row;
      text-align: left;
    }
  }

  .profile-pic {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--border-color);
  }

  .subtitle {
    font-size: 1.5rem;
    color: var(--secondary-text);
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .section {
    margin-bottom: 4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .achievement-list {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .achievement-list li {
    display: flex;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .date {
    min-width: 80px;
    color: var(--secondary-text);
    font-variant-numeric: tabular-nums;
  }

  .view-all {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>
