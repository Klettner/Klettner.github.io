---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Layout title="Projects | Manuel Klettner">
	<h1>Projects</h1>
	<p>A selection of my personal projects and open-source contributions.</p>
	
	<div class="grid">
		{projects.map(async (project) => {
			const { Content } = await project.render();
			return (
				<div class="card">
					{project.data.image && <img src={project.data.image} alt={project.data.title} class="project-image" />}
					<div class="card-header">
						<h3>{project.data.title}</h3>
						<div class="tags">
							{project.data.tags?.map(tag => <span class="tag">{tag}</span>)}
						</div>
					</div>
					<p class="description">{project.data.description}</p>
					{project.data.link && <a href={project.data.link} target="_blank" class="link">View on GitHub &rarr;</a>}
					<div class="content">
						<Content />
					</div>
				</div>
			);
		})}
	</div>
</Layout>

<style>
	.grid {
		display: flex;
		flex-direction: column;
		gap: 4rem;
		margin-top: 3rem;
	}

	.card {
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--border-color);
	}

	.card:last-child {
		border-bottom: none;
	}

	.project-image {
		width: 100%;
		max-height: 400px;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: 2rem;
		border: 1px solid var(--border-color);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.card h3 {
		margin: 0;
		font-size: 1.75rem;
	}

	.description {
		font-size: 1.1rem;
		font-weight: 500;
		color: var(--text-color);
		margin-bottom: 1rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.75rem;
		background: #f0f0f0;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		color: var(--secondary-text);
	}

	.link {
		display: inline-block;
		margin-bottom: 1.5rem;
		font-weight: 600;
		text-decoration: none;
	}

	.content {
		color: var(--secondary-text);
		font-size: 0.95rem;
	}

	.content :global(h3) {
		font-size: 1.25rem;
		color: var(--text-color);
		margin-top: 1.5rem;
	}

	.content :global(ul) {
		padding-left: 1.2rem;
	}
</style>
