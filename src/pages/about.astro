---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';

const experience = (await getCollection('experience')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

const skills = [
  { name: 'C#', category: 'languages' },
  { name: 'Python', category: 'languages' },
  { name: 'TypeScript', category: 'languages' },
  { name: 'JavaScript', category: 'languages' },
  { name: 'Java', category: 'languages' },
  { name: 'Swift', category: 'languages' },
  { name: 'ASP.NET Core', category: 'frameworks' },
  { name: 'React', category: 'frameworks' },
  { name: 'Flutter', category: 'frameworks' },
  { name: 'Node.js', category: 'frameworks' },
  { name: 'REST', category: 'data-api' },
  { name: 'GraphQL', category: 'data-api' },
  { name: 'MQTT', category: 'data-api' },
  { name: 'MongoDB', category: 'data-api' },
  { name: 'SQL', category: 'data-api' },
  { name: 'Git', category: 'cloud-devops' },
  { name: 'Docker', category: 'cloud-devops' },
  { name: 'Kubernetes', category: 'cloud-devops' },
  { name: 'Helm', category: 'cloud-devops' },
  { name: 'OpenShift', category: 'cloud-devops' },
  { name: 'Grafana', category: 'cloud-devops' },
  { name: 'Chaos Engineering', category: 'cloud-devops' },
  { name: 'Google Cloud Platform (GCP)', category: 'cloud-devops' },
  { name: 'Microsoft Azure', category: 'cloud-devops' },
  { name: 'Large Language Models (LLMs)', category: 'ai' },
  { name: 'Cursor', category: 'ai' },
  { name: 'GitHub Copilot', category: 'ai' },
  { name: 'Gemini', category: 'ai' },
  { name: 'Agile Methodologies', category: 'others' },
  { name: 'SCRUM', category: 'others' },
];

const categories = [
  { id: 'all', name: 'All' },
  { id: 'languages', name: 'Languages' },
  { id: 'frameworks', name: 'Frameworks' },
  { id: 'cloud-devops', name: 'Cloud & DevOps' },
  { id: 'data-api', name: 'Data & API' },
  { id: 'ai', name: 'AI' },
  { id: 'others', name: 'Others' },
];
---

<Layout title="About | Manuel Klettner">
  <h1 class="animate-in">About Me</h1>

  <div class="content">
    <div class="animate-in">
      <p>
        I am a Software Engineer at <strong>Rohde & Schwarz</strong> with a focus
        on building robust, scalable, and innovative digital solutions. I hold a Master
        of Science in Information Systems from the Technical University of Munich
        (TUM), where I graduated with distinction.
      </p>

      <p>
        My expertise spans across cloud-native architectures, DevOps and the
        emerging field of Large Language Models (LLMs). I am driven by the
        challenge of solving complex problems through elegant software design.
      </p>
    </div>

    <h2 class="animate-on-scroll">Practical Experience</h2>
    <div class="timeline stagger-children">
      {
        experience.map((exp) => (
          <ExperienceItem
            title={exp.data.title}
            company={exp.data.company}
            location={exp.data.location}
            startDate={exp.data.startDate}
            endDate={exp.data.endDate}
            current={exp.data.current}
            description={exp.data.description}
            class="animate-on-scroll"
          />
        ))
      }
    </div>

    <h2 class="animate-on-scroll">Education</h2>
    <div class="timeline stagger-children">
      <ExperienceItem
        title="Master of Science, Information Systems"
        company="Technical University of Munich"
        period="2022 - 2023"
        description="<strong>Thesis:</strong> Augmenting Knowledge-Based Conversational Search Systems With Large Language Models (Grade: 1.0)"
        class="animate-on-scroll"
      />
      <ExperienceItem
        title="Bachelor of Science, Information Systems"
        company="Technical University of Munich"
        period="2018 - 2022"
        description="Among the top 9% in field of study.<br /><strong>Thesis:</strong> Context-sensitive Requirements Search in Natural Language Specifications (Grade: 1.0)"
        class="animate-on-scroll"
      />
    </div>

    <h2 class="animate-on-scroll">IT Skills</h2>
    <div class="filter-container animate-on-scroll">
      {
        categories.map((cat) => (
          <button
            class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`}
            data-category={cat.id}
          >
            {cat.name}
          </button>
        ))
      }
    </div>
    <ul class="skills-grid animate-on-scroll">
      {
        skills.map((skill) => (
          <li data-category={skill.category}>{skill.name}</li>
        ))
      }
    </ul>

    <h2 class="animate-on-scroll">Languages</h2>
    <div class="languages animate-on-scroll">
      <p><strong>German:</strong> Native</p>
      <p><strong>English:</strong> Full professional proficiency</p>
      <p><strong>Chinese:</strong> Elementary proficiency</p>
      <p><strong>French:</strong> Elementary proficiency</p>
    </div>

    <h2 class="animate-on-scroll">Contact</h2>
    <div class="animate-on-scroll">
      <p>Feel free to reach out to me.</p>
      <ul class="contact-links">
        <li>
          LinkedIn: <a
            href="https://www.linkedin.com/in/klettner"
            target="_blank">linkedin.com/in/klettner</a
          >
        </li>
        <li>
          GitHub: <a href="https://github.com/Klettner" target="_blank"
            >github.com/Klettner</a
          >
        </li>
      </ul>
    </div>
  </div>
</Layout>

<style>
  .content {
    max-width: 100%;
  }

  .timeline {
    margin: 2rem 0 4rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 3rem;
  }

  .skills-grid li {
    background: var(--tag-bg);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    text-align: center;
    border: 1px solid var(--border-color);
    transition:
      background-color 0.3s,
      opacity 0.3s,
      transform 0.3s;
  }

  .skills-grid li.hidden {
    display: none;
  }

  .filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-btn {
    background: var(--tag-bg);
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    cursor: pointer;
    color: var(--text-color);
    transition: all 0.2s;
  }

  .filter-btn:hover {
    border-color: var(--accent-color);
  }

  .filter-btn.active {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
  }

  .languages {
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  .languages p {
    margin: 0.25rem 0;
  }

  .contact-links {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }

  .contact-links li {
    margin-bottom: 0.5rem;
  }
</style>

<script>
  function setupFilters() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const skillItems = document.querySelectorAll('.skills-grid li');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Update active button
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter skills
        skillItems.forEach((item) => {
          if (
            category === 'all' ||
            item.getAttribute('data-category') === category
          ) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  }

  // Run on initial load and after view transitions
  document.addEventListener('astro:page-load', setupFilters);
</script>
